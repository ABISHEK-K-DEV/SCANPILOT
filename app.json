{
  "expo": {
    "name": "ScanPilot",
    "slug": "scanpilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanpilot",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7F9",
    "ios": {
      "bundleIdentifier": "app.scanpilot",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.scanpilot",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#0B0D12",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "ScanPilot uses the camera only while you scan a document. Scans stay on your device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ScanPilot uses the camera only while you scan a document. Photos are processed on this device and never uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ScanPilot needs access to the photos you choose so it can turn them into PDFs on your device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ScanPilot uses Face ID to unlock the app and locked folders. Your face data never leaves your device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
